{%- comment -%}
  Media: a grid of tappable images. One block = one image = one link.
  Tapping an image sends the visitor straight to the address on that block.

  These blocks live only on the Media section, so nothing here is shared
  with the Blog page.

  Usage: {% render 'gallery-media', blocks: section.blocks, columns: 3, count: 9 %}
{%- endcomment -%}

{%- assign ph = 'placeholder-1.svg,placeholder-2.svg,placeholder-3.svg' | split: ',' -%}
{%- assign cols = columns | default: 3 -%}

{%- assign n_blocks = 0 -%}
{%- for block in blocks -%}
  {%- if block.type == 'media_image' -%}{%- assign n_blocks = n_blocks | plus: 1 -%}{%- endif -%}
{%- endfor -%}

<ul class="gallery-grid gallery-grid--{{ cols }}">
  {%- if n_blocks > 0 -%}
    {%- assign i = 0 -%}
    {%- for block in blocks -%}
      {%- if block.type != 'media_image' -%}{%- continue -%}{%- endif -%}
      {%- assign idx = i | modulo: 3 -%}
      {%- assign i = i | plus: 1 -%}
      {%- assign label = block.settings.caption | default: shop.name -%}
      <li {{ block.shopify_attributes }}>
        <a class="gallery-grid__link" href="{{ block.settings.link | default: '#' }}"
           {% if block.settings.new_tab %}target="_blank" rel="noopener"{% endif %}
           aria-label="{{ label | escape }}">
          <span class="gallery-grid__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1600 | image_tag:
                 widths: '400,600,900,1200,1600',
                 sizes: '(max-width: 749px) 100vw, (max-width: 900px) 50vw, 33vw',
                 alt: label,
                 loading: 'lazy' }}
            {%- else -%}
              <img src="{{ ph[idx] | asset_url }}" alt="{{ label | escape }}"
                   width="1200" height="1500" loading="lazy">
            {%- endif -%}
          </span>
          {%- if block.settings.caption != blank -%}
            <span class="gallery-grid__caption">{{ block.settings.caption }}</span>
          {%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  {%- else -%}
    {%- assign slots = count | default: 9 -%}
    {%- for n in (1..slots) -%}
      {%- assign idx = forloop.index0 | modulo: 3 -%}
      <li>
        <a class="gallery-grid__link" href="#" aria-label="Media {{ n }}">
          <span class="gallery-grid__media">
            <img src="{{ ph[idx] | asset_url }}" alt="Media {{ n }}"
                 width="1200" height="1500" loading="lazy">
          </span>
        </a>
      </li>
    {%- endfor -%}
  {%- endif -%}
</ul>
