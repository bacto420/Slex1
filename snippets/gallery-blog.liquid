{%- comment -%}
  Blog: nothing but images, each one the full width of the site, stacked
  directly on top of the next with no gap and no link.

  These blocks live only on the Blog section, so nothing here is shared with
  the Media page.

  Usage: {% render 'gallery-blog', blocks: section.blocks, ratio: 'natural', count: 5 %}
{%- endcomment -%}

{%- assign ph = 'placeholder-wide-1.svg,placeholder-wide-2.svg,placeholder-wide-3.svg,placeholder-wide-4.svg,placeholder-wide-5.svg' | split: ',' -%}
{%- assign r = ratio | default: 'natural' -%}

{%- assign n_blocks = 0 -%}
{%- for block in blocks -%}
  {%- if block.type == 'blog_image' -%}{%- assign n_blocks = n_blocks | plus: 1 -%}{%- endif -%}
{%- endfor -%}

<ul class="gallery-stack gallery-stack--{{ r }}">
  {%- if n_blocks > 0 -%}
    {%- assign i = 0 -%}
    {%- for block in blocks -%}
      {%- if block.type != 'blog_image' -%}{%- continue -%}{%- endif -%}
      {%- assign idx = i | modulo: 5 -%}
      {%- assign i = i | plus: 1 -%}
      <li {{ block.shopify_attributes }}>
        <span class="gallery-stack__frame">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag:
               widths: '600,900,1200,1800,2400', sizes: '100vw',
               alt: block.settings.caption | default: shop.name,
               loading: 'lazy' }}
          {%- else -%}
            <img src="{{ ph[idx] | asset_url }}" alt="{{ block.settings.caption | default: shop.name | escape }}"
                 width="1600" height="900" loading="lazy">
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <span class="gallery-stack__caption">{{ block.settings.caption }}</span>
          {%- endif -%}
        </span>
      </li>
    {%- endfor -%}
  {%- else -%}
    {%- assign slots = count | default: 5 -%}
    {%- for n in (1..slots) -%}
      {%- assign idx = forloop.index0 | modulo: 5 -%}
      <li>
        <span class="gallery-stack__frame">
          <img src="{{ ph[idx] | asset_url }}" alt=""
               width="1600" height="900" loading="lazy">
        </span>
      </li>
    {%- endfor -%}
  {%- endif -%}
</ul>
