<div class="product">
  <div class="product__gallery">
    {%- if product.images.size > 0 -%}
      {%- for image in product.images -%}
        <div class="split__media">
          {{ image | image_url: width: 1600 | image_tag:
             widths: '400,600,900,1200,1600',
             sizes: '(max-width: 900px) 100vw, 55vw',
             alt: image.alt | default: product.title,
             loading: 'lazy' }}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="split__media">
        <img src="{{ 'placeholder-product-1.svg' | asset_url }}" alt="{{ product.title }}"
             width="1200" height="1500">
      </div>
    {%- endif -%}
  </div>

  <div class="product__info">
    <h1 class="product__title">{{ product.title }}</h1>
    <div class="product__price" data-variant-price>{%- render 'price', product: product -%}</div>

    {%- if product.description != blank -%}
      <div class="product__description rte">{{ product.description }}</div>
    {%- endif -%}

    {%- form 'product', product, data-product-form: 'main' -%}
      {%- comment -%}
        One select, named `id`, listing the variants themselves.

        It used to be one select per option, named options[Größe], with the
        chosen variant carried separately in a hidden `id` field that nothing
        ever updated. Shopify's cart takes `id` when both are sent, so every
        order arrived as the first available variant no matter what the
        customer picked — pick XL, get S.

        Sending the variant id directly is the whole fix: it is what the cart
        reads, it needs no JavaScript to stay in step, and a variant that
        cannot be bought is not offered in the first place.
      {%- endcomment -%}
      {%- assign chosen = product.selected_or_first_available_variant -%}

      {%- if product.has_only_default_variant -%}
        <input type="hidden" name="id" value="{{ chosen.id }}">
      {%- else -%}
        {%- assign option_label = 'products.variant' | t -%}
        {%- if product.options.size == 1 -%}
          {%- assign option_label = product.options.first -%}
        {%- endif -%}

        <label class="field-label" for="VariantSelect-{{ section.id }}">{{ option_label }}</label>
        <select id="VariantSelect-{{ section.id }}" name="id" data-variant-select>
          {%- for v in product.variants -%}
            <option value="{{ v.id }}"
                    {% if v.id == chosen.id %}selected{% endif %}
                    {% unless v.available %}disabled{% endunless %}>
              {{ v.title }}{% unless v.available %} — {{ 'products.sold_out' | t }}{% endunless %}
            </option>
          {%- endfor -%}
        </select>

        {%- comment -%}
          The price beside the title follows the selection. Each variant's
          price is rendered here by the same snippet that prints the one on
          the page, so the money format and the struck-through comparison
          cannot drift apart from it.
        {%- endcomment -%}
        <script type="application/json" data-variant-json>
          [
            {%- for v in product.variants -%}
              {%- capture v_price -%}{%- render 'price', product: product, variant: v -%}{%- endcapture -%}
              {"id": {{ v.id }}, "available": {{ v.available }}, "price": {{ v_price | strip | json }}}
              {%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        </script>
      {%- endif -%}

      <label class="field-label" for="Quantity">{{ 'products.quantity' | t }}</label>
      <input type="number" id="Quantity" name="quantity" value="1" min="1">

      <button type="submit" class="btn"
              data-variant-button
              data-label-add="{{ 'products.add_to_cart' | t | escape }}"
              data-label-sold-out="{{ 'products.sold_out' | t | escape }}"
              {% unless chosen.available %}disabled{% endunless %}>
        {%- if chosen.available -%}
          {{ 'products.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.sold_out' | t }}
        {%- endif -%}
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
