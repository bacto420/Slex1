{%- comment -%}
  Default page section — ordinary page text.

  It used to carry both the Blog image blocks and the Media tile blocks.
  Shopify stores blocks on the TEMPLATE, not on the individual page, so every
  page running on "page.json" shared one single set of blocks: filling in an
  image on the Blog page changed the Media page too, and the other way round.

  Blog and Media are now two separate sections on this template, each with
  its own blocks, and each rendering only on the page it belongs to. Nothing
  is shared any more, and no page has to have a template picked for it.

  On those two pages this section steps aside — the Blog and Media sections
  print the heading and the page text themselves.
{%- endcomment -%}

{%- assign handle = page.handle | default: '' -%}
{%- assign taken_over = false -%}
{%- if handle contains 'blog' or handle contains 'journal'
    or handle contains 'media' or handle contains 'presse' -%}
  {%- assign taken_over = true -%}
{%- endif -%}

{%- unless taken_over -%}
  <div class="article">
    {%- if section.settings.show_title -%}<h1>{{ page.title }}</h1>{%- endif -%}
    <div class="rte">{{ page.content }}</div>
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true },
    {
      "type": "paragraph",
      "content": "On the Blog and Media pages this section stays empty — edit those images in the “Blog” and “Media” sections below."
    }
  ]
}
{% endschema %}
