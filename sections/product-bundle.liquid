{%- comment -%}
  Bundle deal.

  A bundle is a row of slots. A slot is either one fixed product, or a
  choice between several — two jackets, say, of which the customer takes
  one. Each slot also carries its own size picker when the chosen product
  has variants.

  Why the size picker matters: without it the form can only send
  selected_or_first_available_variant, so every bundle lands in the cart in
  whatever size happens to come first. The customer notices at the cart, or
  worse, on delivery.

  Prices are rendered by Liquid for the default selection and recomputed in
  the browser as the customer switches. Without JavaScript the defaults
  stand and the form still posts a valid, complete bundle — one size and one
  product per slot, exactly what Liquid printed.

  IMPORTANT: the theme only shows the deal. The saving has to exist as an
  automatic discount in the admin, or the cart charges full price against a
  page that promised less.
{%- endcomment -%}

{%- liquid
  assign pct = section.settings.discount_percent | default: 15
  assign default_ids = ''

  assign slots = 0
  assign regular = 0
  assign cheapest = 0
  assign all_available = true

  for block in section.blocks
    assign first = blank
    if block.type == 'bundle_item'
      assign first = block.settings.product
    else
      for n in (1..4)
        assign key = 'product_' | append: n
        assign candidate = block.settings[key]
        if candidate != blank and first == blank
          assign first = candidate
        endif
      endfor
    endif

    if first == blank
      continue
    endif

    assign slots = slots | plus: 1
    assign variant = first.selected_or_first_available_variant
    if default_ids == blank
      assign default_ids = variant.id | append: ''
    else
      assign default_ids = default_ids | append: ',' | append: variant.id
    endif
    assign regular = regular | plus: variant.price
    if cheapest == 0 or variant.price < cheapest
      assign cheapest = variant.price
    endif
    unless first.available
      assign all_available = false
    endunless
  endfor

  if section.settings.discount_scope == 'cheapest'
    assign saving = cheapest | times: pct | divided_by: 100.0 | round
  else
    assign saving = regular | times: pct | divided_by: 100.0 | round
  endif
  assign bundle_total = regular | minus: saving

  assign wrap = 'page-width section bundle'
  if section.settings.layout == 'centered'
    assign wrap = 'section bundle bundle--centered'
  endif
-%}

{%- if slots > 1 -%}
  <div class="{{ wrap }}"
       data-bundle
       data-bundle-pct="{{ pct }}"
       data-bundle-scope="{{ section.settings.discount_scope | default: 'total' }}"
       data-money-format="{{ shop.money_format | escape }}">

    <div class="bundle__head">
      <h2 class="section__title bundle__title">{{ section.settings.title }}</h2>
      <span class="bundle__badge">−{{ pct }}%</span>
    </div>

    {%- if section.settings.subtitle != blank -%}
      <p class="bundle__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="bundle__body">
      <ul class="bundle__set">
        {%- assign shown = 0 -%}
        {%- for block in section.blocks -%}
          {%- comment -%}
            A slot offers one product or a choice of up to four. Both kinds
            are walked with the same loop, so the markup below is written
            once: for a fixed block only the first pass yields a product.
          {%- endcomment -%}
          {%- assign p0 = blank -%}
          {%- assign option_count = 0 -%}
          {%- for n in (1..4) -%}
            {%- if block.type == 'bundle_item' -%}
              {%- assign candidate = block.settings.product -%}
              {%- if n > 1 -%}{%- assign candidate = blank -%}{%- endif -%}
            {%- else -%}
              {%- assign key = 'product_' | append: n -%}
              {%- assign candidate = block.settings[key] -%}
            {%- endif -%}
            {%- if candidate == blank -%}{%- continue -%}{%- endif -%}
            {%- assign option_count = option_count | plus: 1 -%}
            {%- if p0 == blank -%}{%- assign p0 = candidate -%}{%- endif -%}
          {%- endfor -%}
          {%- if option_count == 0 -%}{%- continue -%}{%- endif -%}

          {%- assign shown = shown | plus: 1 -%}
          {%- if shown > 1 -%}
            <li class="bundle__plus" aria-hidden="true">+</li>
          {%- endif -%}

          <li class="bundle__item" data-slot="{{ shown | minus: 1 }}" {{ block.shopify_attributes }}>
            {%- comment -%}
              Every product the slot offers is rendered. All but the first
              are hidden, and the script swaps which one shows; with the
              script blocked the first one stands, and it is the one the
              form posts.
            {%- endcomment -%}
            <div class="bundle__options">
              {%- assign seen = 0 -%}
              {%- for n in (1..4) -%}
                {%- if block.type == 'bundle_item' -%}
                  {%- assign p = block.settings.product -%}
                  {%- if n > 1 -%}{%- assign p = blank -%}{%- endif -%}
                {%- else -%}
                  {%- assign key = 'product_' | append: n -%}
                  {%- assign p = block.settings[key] -%}
                {%- endif -%}
                {%- if p == blank -%}{%- continue -%}{%- endif -%}
                {%- assign seen = seen | plus: 1 -%}

                <button type="button"
                        class="bundle__option{% if seen > 1 %} is-hidden{% endif %}"
                        data-option="{{ p.id }}"
                        aria-pressed="{% if seen == 1 %}true{% else %}false{% endif %}"
                        {% if option_count == 1 %}data-single{% endif %}>
                  <span class="bundle__media">
                    {%- if p.featured_image -%}
                      {{ p.featured_image | image_url: width: 800 | image_tag:
                         widths: '200,300,400,600,800',
                         sizes: '(max-width: 749px) 45vw, 260px',
                         alt: p.title,
                         loading: 'lazy' }}
                    {%- else -%}
                      <img src="{{ 'placeholder-product-1.svg' | asset_url }}" alt="{{ p.title | escape }}"
                           width="1200" height="1500" loading="lazy">
                    {%- endif -%}
                  </span>
                  <span class="bundle__name">{{ p.title }}</span>
                </button>
              {%- endfor -%}
            </div>

            {%- comment -%}
              Switching between the products of a choice slot sits apart from
              the thumbnails, so a tap meant for the size picker cannot land
              on a product instead.
            {%- endcomment -%}
            {%- if option_count > 1 -%}
              <div class="bundle__switch" role="group"
                   aria-label="{{ section.settings.label_choose | default: 'Auswahl' }}">
                {%- assign seen = 0 -%}
                {%- for n in (1..4) -%}
                  {%- assign key = 'product_' | append: n -%}
                  {%- assign p = block.settings[key] -%}
                  {%- if p == blank -%}{%- continue -%}{%- endif -%}
                  {%- assign seen = seen | plus: 1 -%}
                  <button type="button" class="bundle__swatch"
                          data-switch="{{ p.id }}"
                          aria-pressed="{% if seen == 1 %}true{% else %}false{% endif %}">
                    {{ p.title }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            <p class="bundle__price" data-slot-price>
              {{ p0.selected_or_first_available_variant.price | money }}
            </p>

            {%- comment -%}
              One size picker per slot, refilled by the script when the
              product changes. It is rendered from the first product so it is
              already right before any script runs, and hidden rather than
              skipped when that product has a single variant — another
              product in the same slot may well have sizes.
            {%- endcomment -%}
            <label class="bundle__size"{% if p0.has_only_default_variant %} hidden{% endif %}>
              <span class="bundle__size-label">{{ p0.options.first }}</span>
              <select data-slot-variant>
                {%- for v in p0.variants -%}
                  <option value="{{ v.id }}" data-price="{{ v.price }}"
                          {% unless v.available %}disabled{% endunless %}
                          {% if v.id == p0.selected_or_first_available_variant.id %}selected{% endif %}>
                    {{ v.title }}{% unless v.available %} — {{ section.settings.label_sold_out }}{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </label>

            {%- comment -%}
              What the script needs about this slot, handed over as data
              rather than as markup it would have to read back out.
            {%- endcomment -%}
            <script type="application/json" data-slot-json>
              {
                "products": [
                  {%- assign seen = 0 -%}
                  {%- for n in (1..4) -%}
                    {%- if block.type == 'bundle_item' -%}
                      {%- assign p = block.settings.product -%}
                      {%- if n > 1 -%}{%- assign p = blank -%}{%- endif -%}
                    {%- else -%}
                      {%- assign key = 'product_' | append: n -%}
                      {%- assign p = block.settings[key] -%}
                    {%- endif -%}
                    {%- if p == blank -%}{%- continue -%}{%- endif -%}
                    {%- assign seen = seen | plus: 1 -%}
                    {%- if seen > 1 -%},{%- endif -%}
                    {
                      "id": {{ p.id }},
                      "optionName": {{ p.options.first | default: '' | json }},
                      "hasOneVariant": {{ p.has_only_default_variant }},
                      "variants": [
                        {%- for v in p.variants -%}
                          { "id": {{ v.id }}, "title": {{ v.title | json }},
                            "price": {{ v.price }}, "available": {{ v.available }} }
                          {%- unless forloop.last -%},{%- endunless -%}
                        {%- endfor -%}
                      ]
                    }
                  {%- endfor -%}
                ]
              }
            </script>
          </li>
        {%- endfor -%}
      </ul>

      <div class="bundle__summary">
        <dl class="bundle__totals">
          <div>
            <dt>{{ section.settings.label_regular }}</dt>
            <dd><s data-total-regular>{{ regular | money }}</s></dd>
          </div>
          <div class="bundle__totals-row--deal">
            <dt>{{ section.settings.label_bundle }}</dt>
            <dd data-total-bundle>{{ bundle_total | money }}</dd>
          </div>
        </dl>

        <p class="bundle__saving">
          {{ section.settings.label_saving }} <span data-total-saving>{{ saving | money }}</span>
        </p>

        {%- if all_available -%}
          <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data"
                class="bundle__form" data-bundle-form>
            {%- assign default_list = default_ids | split: ',' -%}
            {%- for id in default_list -%}
              {%- assign line = forloop.index0 -%}
              <input type="hidden" name="items[{{ line }}][id]" value="{{ id }}" data-line="{{ line }}">
              <input type="hidden" name="items[{{ line }}][quantity]" value="1">
            {%- endfor -%}
            <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
            <button type="submit" class="btn bundle__btn">{{ section.settings.button_label }}</button>
          </form>
        {%- else -%}
          <p class="bundle__sold-out">{{ section.settings.label_sold_out }}</p>
        {%- endif -%}

        {%- if section.settings.note != blank -%}
          <p class="bundle__note">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>

{%- elsif request.design_mode -%}
  {%- comment -%}
    Editor only, so the section can be found and filled in. Never shown in
    the shop, and it carries no prices: an example price is a promise the
    checkout would not keep.
  {%- endcomment -%}
  <div class="{{ wrap }} bundle--setup">
    <div class="bundle__head">
      <h2 class="section__title bundle__title">{{ section.settings.title }}</h2>
      <span class="bundle__badge">−{{ pct }}%</span>
    </div>

    <ul class="bundle__set">
      {%- for block in section.blocks -%}
        {%- if forloop.index0 > 0 -%}
          <li class="bundle__plus" aria-hidden="true">+</li>
        {%- endif -%}
        <li class="bundle__item" {{ block.shopify_attributes }}>
          <span class="bundle__media">
            <img src="{{ 'placeholder-product-1.svg' | asset_url }}" alt=""
                 width="1200" height="1500" loading="lazy">
          </span>
          <span class="bundle__name">
            {%- if block.type == 'bundle_choice' -%}Auswahl{%- else -%}Produkt{%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>

    <p class="bundle__setup-note">
      Pick a product in each block on the left. A “Bundle choice” block can
      hold several — the customer takes one of them. The bundle appears in
      the shop as soon as two slots are filled.
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bundle deal",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The theme only shows the deal. Create the matching automatic discount under Discounts in the admin, otherwise the cart charges full price."
    },
    { "type": "text", "id": "title", "label": "Heading", "default": "Bundle deal" },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Buy the jacket together with the longsleeve and save 15%."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Products left, summary right" },
        { "value": "centered", "label": "Full width, centred" }
      ],
      "default": "split"
    },
    {
      "type": "range",
      "id": "tile_width",
      "min": 220,
      "max": 520,
      "step": 20,
      "unit": "px",
      "label": "Product size",
      "info": "Only applies to the centred layout.",
      "default": 360
    },
    {
      "type": "header",
      "content": "Saving"
    },
    {
      "type": "range",
      "id": "discount_percent",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "%",
      "label": "Discount",
      "default": 15
    },
    {
      "type": "select",
      "id": "discount_scope",
      "label": "Discount applies to",
      "info": "Must match the automatic discount in the admin, so the price shown here is the price the customer pays.",
      "options": [
        { "value": "total", "label": "The whole bundle" },
        { "value": "cheapest", "label": "The cheaper item only (Buy X get Y)" }
      ],
      "default": "total"
    },
    {
      "type": "header",
      "content": "Wording"
    },
    { "type": "text", "id": "label_regular", "label": "Regular total", "default": "Separately" },
    { "type": "text", "id": "label_bundle", "label": "Bundle total", "default": "Together" },
    { "type": "text", "id": "label_saving", "label": "Saving", "default": "You save" },
    { "type": "text", "id": "label_choose", "label": "Choice group label", "default": "Auswahl" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Add bundle to cart" },
    { "type": "text", "id": "label_sold_out", "label": "Unavailable", "default": "ausverkauft" },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "The saving is applied automatically at checkout."
    }
  ],
  "blocks": [
    {
      "type": "bundle_item",
      "name": "Bundle product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    },
    {
      "type": "bundle_choice",
      "name": "Bundle choice",
      "settings": [
        {
          "type": "paragraph",
          "content": "The customer takes one of these. Leave a slot empty to offer fewer."
        },
        { "type": "product", "id": "product_1", "label": "Option 1" },
        { "type": "product", "id": "product_2", "label": "Option 2" },
        { "type": "product", "id": "product_3", "label": "Option 3" },
        { "type": "product", "id": "product_4", "label": "Option 4" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Bundle deal",
      "blocks": [
        { "type": "bundle_choice" },
        { "type": "bundle_item" }
      ]
    }
  ]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} .bundle--centered {
    --bundle-tile: {{ section.settings.tile_width | default: 360 }}px;
  }
</style>
