{%- comment -%}
  Shop — shows the products of the collection straight away (3 products).
  Falls back to placeholder tiles while the store is still empty.
{%- endcomment -%}

{%- assign ph_products = 'placeholder-product-1.svg,placeholder-product-2.svg,placeholder-product-3.svg' | split: ',' -%}

<div class="page-width section">
  {%- if section.settings.show_title -%}
    <h1 class="section__title">{{ collection.title | default: 'Shop' }}</h1>
  {%- endif -%}

  {%- if collection.products_count > 0 -%}
    <ul class="product-grid">
      {%- for product in collection.products limit: section.settings.products_limit -%}
        <li>
          <a class="product-tile" href="{{ product.url }}">
            <div class="product-tile__media">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 1200 | image_tag:
                   widths: '300,500,700,900,1200',
                   sizes: '(max-width: 749px) 100vw, 33vw',
                   alt: product.title,
                   loading: 'lazy' }}
              {%- else -%}
                {%- assign idx = forloop.index0 | modulo: 3 -%}
                <img src="{{ ph_products[idx] | asset_url }}" alt="{{ product.title }}"
                     width="1200" height="1500" loading="lazy">
              {%- endif -%}
            </div>
            <div class="product-card__meta">
              <span>{{ product.title }}</span>
              {%- if section.settings.show_price -%}
                <span class="product-card__price">{{ product.price | money }}</span>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <ul class="product-grid">
      {%- for i in (1..3) -%}
        {%- assign idx = forloop.index0 -%}
        <li>
          <a class="product-tile" href="{{ routes.all_products_collection_url }}">
            <div class="product-tile__media">
              <img src="{{ ph_products[idx] | asset_url }}" alt="Product 0{{ i }}"
                   width="1200" height="1500" loading="lazy">
            </div>
            <div class="product-card__meta">
              <span>Product 0{{ i }}</span>
              {%- if section.settings.show_price -%}
                <span class="product-card__price">&mdash;</span>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Shop grid",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show collection title", "default": true },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "range", "id": "products_limit", "min": 3, "max": 24, "step": 1, "label": "Products shown", "default": 3 }
  ]
}
{% endschema %}
