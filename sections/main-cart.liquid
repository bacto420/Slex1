<div class="cart">
  <h1 class="section__title">{{ 'cart.title' | t }}</h1>

  {%- if cart.item_count > 0 -%}
    {%- form 'cart', cart -%}
      <table class="cart-table">
        <thead>
          <tr>
            <th colspan="2">{{ 'cart.product' | t }}</th>
            <th>{{ 'products.quantity' | t }}</th>
            <th style="text-align:right;">{{ 'cart.total' | t }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr>
              <td style="width: 110px;">
                <a href="{{ item.url }}">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 200 | image_tag: alt: item.title, loading: 'lazy' }}
                  {%- else -%}
                    <img src="{{ 'placeholder-product-1.svg' | asset_url }}" alt="{{ item.title }}">
                  {%- endif -%}
                </a>
              </td>
              <td>
                <a href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <div class="card__meta">{{ item.variant.title }}</div>
                {%- endunless -%}
                <div class="card__meta">{{ item.original_price | money }}</div>
              </td>
              <td>
                <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"
                       aria-label="{{ 'products.quantity' | t }}">
                <div><a class="card__meta" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div>
              </td>
              <td style="text-align:right;">{{ item.original_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <div class="cart__footer">
        <button type="submit" name="update" class="btn btn--ghost btn--inline">{{ 'cart.update' | t }}</button>
        <div class="cart__totals">
          <div class="card__meta" style="margin-bottom: var(--space-sm);">
            {{ 'cart.subtotal' | t }} — {{ cart.total_price | money }}
          </div>
          <button type="submit" name="checkout" class="btn">{{ 'cart.checkout' | t }}</button>
        </div>
      </div>
    {%- endform -%}
  {%- else -%}
    <p>{{ 'cart.empty' | t }}</p>
    <p>
      <a class="btn btn--ghost btn--inline" href="{{ routes.all_products_collection_url }}">
        {{ 'general.nav.shop' | t }}
      </a>
    </p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
