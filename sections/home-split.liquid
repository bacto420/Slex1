{%- comment -%}
  Homepage — the only section on the index template.
  Left column: 3 editorial images. Right column: 3 product images with the name only.
  Both columns share one grid so the rows always line up.
{%- endcomment -%}

{%- assign ph_images = 'placeholder-1.svg,placeholder-2.svg,placeholder-3.svg' | split: ',' -%}
{%- assign ph_products = 'placeholder-product-1.svg,placeholder-product-2.svg,placeholder-product-3.svg' | split: ',' -%}

<div class="split">
  {%- for i in (1..3) -%}
    {%- assign idx = forloop.index0 -%}

    {%- comment -%} Left cell — editorial image {%- endcomment -%}
    {%- assign image_key = 'image_' | append: i -%}
    {%- assign image = section.settings[image_key] -%}
    <div class="split__cell split__cell--image">
      <div class="split__media">
        {%- if image != blank -%}
          {{ image | image_url: width: 1600 | image_tag:
             widths: '400,600,900,1200,1600',
             sizes: '(max-width: 749px) 100vw, 50vw',
             alt: image.alt | default: shop.name,
             loading: 'lazy' }}
        {%- else -%}
          <img src="{{ ph_images[idx] | asset_url }}"
               alt="{{ shop.name }} image {{ i }}"
               width="1200" height="1500" loading="lazy">
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Right cell — product image + name only {%- endcomment -%}
    {%- assign product_key = 'product_' | append: i -%}
    {%- assign product = section.settings[product_key] -%}
    {%- comment -%} Handle both object and handle-string returns from the product setting. {%- endcomment -%}
    {%- if product != blank and product.id == nil -%}
      {%- assign product = all_products[product] -%}
    {%- endif -%}
    {%- assign fallback_key = 'product_name_' | append: i -%}

    {%- if product != blank and product.id -%}
      <a class="split__cell product-tile" href="{{ product.url }}">
        <div class="product-tile__inner">
        <div class="product-tile__media">
          {%- if product.featured_image -%}
            {{ product.featured_image | image_url: width: 1600 | image_tag:
               widths: '400,600,900,1200,1600',
               sizes: '(max-width: 749px) 100vw, 50vw',
               alt: product.title,
               loading: 'lazy' }}
          {%- else -%}
            <img src="{{ ph_products[idx] | asset_url }}" alt="{{ product.title }}"
                 width="1200" height="1500" loading="lazy">
          {%- endif -%}
        </div>
        <p class="product-tile__name">{{ product.title }}</p>
        </div>
      </a>
    {%- else -%}
      <a class="split__cell product-tile" href="{{ routes.all_products_collection_url }}">
        <div class="product-tile__inner">
        <div class="product-tile__media">
          <img src="{{ ph_products[idx] | asset_url }}"
               alt="{{ section.settings[fallback_key] }}"
               width="1200" height="1500" loading="lazy">
        </div>
        <p class="product-tile__name">{{ section.settings[fallback_key] }}</p>
        </div>
      </a>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Home split",
  "settings": [
    { "type": "header", "content": "Left column — images" },
    { "type": "image_picker", "id": "image_1", "label": "Image 1" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3" },
    { "type": "header", "content": "Right column — products" },
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "text", "id": "product_name_1", "label": "Fallback name 1", "default": "Product 01" },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "text", "id": "product_name_2", "label": "Fallback name 2", "default": "Product 02" },
    { "type": "product", "id": "product_3", "label": "Product 3" },
    { "type": "text", "id": "product_name_3", "label": "Fallback name 3", "default": "Product 03" }
  ],
  "presets": [
    { "name": "Home split" }
  ]
}
{% endschema %}
