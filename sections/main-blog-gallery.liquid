{%- comment -%}
  Blog — a grid of images, each one linking straight out to its own address.

  The images live in this section's own blocks. The Media section keeps its
  own, separate blocks, so filling one in never touches the other.
{%- endcomment -%}

<div class="blog-page">
  {%- if section.settings.title != blank and section.settings.show_title -%}
    <h1 class="blog-page__title">{{ section.settings.title }}</h1>
  {%- endif -%}

  {%- if page.content != blank -%}
    <div class="blog-page__intro rte">{{ page.content }}</div>
  {%- endif -%}

  {%- render 'gallery-blog',
      blocks: section.blocks,
      columns: section.settings.columns,
      count: section.settings.placeholder_count -%}
</div>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Blog" },
    { "type": "checkbox", "id": "show_title", "label": "Show title", "default": true },
    {
      "type": "paragraph",
      "content": "Add one \"Blog image\" block per picture. Each block carries its own image and its own link — tapping the picture opens that link."
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Images per row",
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "info": "Every tile is cropped to the same shape so the grid stays even.",
      "options": [
        { "value": "wide", "label": "16:9" },
        { "value": "classic", "label": "4:3" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "4:5 portrait" }
      ],
      "default": "wide"
    },
    {
      "type": "range",
      "id": "placeholder_count",
      "min": 3,
      "max": 20,
      "step": 1,
      "label": "Placeholder images",
      "info": "Only shown until you add your first Blog image block.",
      "default": 9
    }
  ],
  "blocks": [
    {
      "type": "blog_image",
      "name": "Blog image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link", "info": "Where tapping this image leads." },
        { "type": "checkbox", "id": "new_tab", "label": "Open in a new tab", "default": true },
        { "type": "text", "id": "caption", "label": "Caption", "info": "Optional. Shown under the image." }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Blog",
      "blocks": [
        { "type": "blog_image" }, { "type": "blog_image" }, { "type": "blog_image" },
        { "type": "blog_image" }, { "type": "blog_image" }, { "type": "blog_image" },
        { "type": "blog_image" }, { "type": "blog_image" }, { "type": "blog_image" }
      ]
    }
  ]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} .blog-grid {
    --blog-tile-ratio: {% case section.settings.image_ratio %}
      {%- when 'classic' -%}4 / 3
      {%- when 'square' -%}1 / 1
      {%- when 'portrait' -%}4 / 5
      {%- else -%}16 / 9
    {% endcase %};
  }
</style>
