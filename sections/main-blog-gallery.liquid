{%- comment -%}
  Blog — images at the full width of the site, stacked flush on top of each
  other. No page gutter, no gap, no links.

  The images live in this section's own blocks. The Media section is a
  separate section with separate blocks, so filling one in never touches the
  other.

  The section sits on the default page template together with Media, so
  neither page needs a template picked for it in the admin. Each one only
  shows up where it belongs, decided by the page handle:

      handle contains "blog" or "journal"  → this section
      no page at all (search view template) → this section

  Everywhere else it stays silent, apart from a note in the theme editor
  saying where it does appear.
{%- endcomment -%}

{%- assign handle = page.handle | default: '' -%}
{%- assign show = true -%}
{%- if handle != blank -%}
  {%- unless handle contains 'blog' or handle contains 'journal' -%}
    {%- assign show = false -%}
  {%- endunless -%}
{%- endif -%}

{%- unless show -%}
  {%- if request.design_mode -%}
    <p class="section-note">
      “{{ section.settings.title | default: 'Blog' }}” only appears on a page whose web address
      contains “blog”. Nothing from this section is shown on “{{ page.title }}”.
    </p>
  {%- endif -%}
{%- else -%}

<div class="blog-page">
  {%- if section.settings.title != blank and section.settings.show_title -%}
    <h1 class="blog-page__title">{{ section.settings.title }}</h1>
  {%- endif -%}

  {%- if page.content != blank -%}
    <div class="blog-page__intro rte">{{ page.content }}</div>
  {%- endif -%}

  {%- render 'gallery-blog',
      blocks: section.blocks,
      ratio: section.settings.image_ratio,
      count: section.settings.placeholder_count -%}
</div>

{%- endunless -%}

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Blog" },
    { "type": "checkbox", "id": "show_title", "label": "Show title", "default": true },
    {
      "type": "paragraph",
      "content": "Add one \"Blog image\" block per picture. Each one runs across the full width of the site."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image height",
      "info": "\"Original\" keeps each image as it is. The other options crop every image to the same shape so the column stays even.",
      "options": [
        { "value": "natural", "label": "Original proportions" },
        { "value": "wide", "label": "Crop to 16:9" },
        { "value": "cinema", "label": "Crop to 21:9" },
        { "value": "classic", "label": "Crop to 4:3" }
      ],
      "default": "natural"
    },
    {
      "type": "range",
      "id": "placeholder_count",
      "min": 3,
      "max": 20,
      "step": 1,
      "label": "Placeholder images",
      "info": "Only shown until you add your first Blog image block.",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "blog_image",
      "name": "Blog image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption", "info": "Optional. Shown over the image." }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Blog",
      "blocks": [
        { "type": "blog_image" }, { "type": "blog_image" }, { "type": "blog_image" },
        { "type": "blog_image" }, { "type": "blog_image" }
      ]
    }
  ]
}
{% endschema %}
