{%- comment -%}
  Size chart — a drawing with lettered measuring points and a table that
  uses the same letters.

  Rows are blocks, so a garment with more or fewer measurements needs no
  code change, and the size columns come from one comma-separated setting.
  A row prints only the columns that exist, so switching from four sizes to
  three never leaves a stray cell behind.

  The drawing is inline SVG rather than an uploaded image: it inherits the
  text colour, stays sharp at any size, and has no second file to keep in
  step with the theme.
{%- endcomment -%}

{%- assign sizes = section.settings.sizes | default: 'S,M,L,XL' | split: ',' -%}

<div class="page-width section sizechart" id="SizeChart">
  <div class="sizechart__head">
    <h2 class="section__title sizechart__title">{{ section.settings.title }}</h2>
    {%- if section.settings.intro != blank -%}
      <p class="sizechart__intro">{{ section.settings.intro }}</p>
    {%- endif -%}
  </div>

  <div class="sizechart__body">
    <div class="sizechart__figure">
      {%- comment -%}
        Flat lay of a long-sleeved top. The letters sit on the measurement
        lines, not on the garment, so it stays readable at thumbnail size.
      {%- endcomment -%}
      <svg viewBox="0 0 400 330" role="img" aria-labelledby="SizeChartFigureTitle">
        <title id="SizeChartFigureTitle">{{ section.settings.figure_alt }}</title>

        <g class="sizechart__garment" fill="none" stroke="currentColor" stroke-width="2.6"
           stroke-linejoin="round" stroke-linecap="round">
          <path d="M132 72 L176 72 Q200 90 224 72 L268 72
                   L358 200 L318 228 L266 130 L272 232
                   Q200 274 128 232 L134 130 L82 228 L42 200 Z"/>
        </g>

        {%- comment -%} Ribbed collar and cuffs — what tells this piece apart. {%- endcomment -%}
        <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.9">
          <path d="M178 80 Q200 98 222 80"/>
          <path d="M342 177 L302 205"/>
          <path d="M58 177 L98 205"/>
        </g>
        <g fill="none" stroke="currentColor" stroke-width="1" opacity="0.45">
          <path d="M347 185 L307 213 M353 192 L313 220"/>
          <path d="M53 185 L93 213 M47 192 L87 220"/>
        </g>

        <g class="sizechart__marks" fill="none" stroke="currentColor" stroke-width="1.2">
          {%- comment -%} A — across the shoulders {%- endcomment -%}
          <path d="M132 46 L268 46 M132 40 L132 52 M268 40 L268 52"/>

          {%- comment -%} D — across the hem at its widest {%- endcomment -%}
          <path d="M128 294 L272 294 M128 288 L128 300 M272 288 L272 300"/>

          {%- comment -%} B — from the armpit down to the curved hem {%- endcomment -%}
          <path d="M240 134 L240 246 M234 134 L246 134 M234 246 L246 246"/>

          {%- comment -%} C — along the outer sleeve {%- endcomment -%}
          <path d="M279 64 L369 192 M274 66 L284 61 M364 194 L374 189"/>
        </g>

        <g class="sizechart__letters" fill="currentColor">
          <text x="200" y="32"  text-anchor="middle">A</text>
          <text x="200" y="318" text-anchor="middle">D</text>
          <text x="226" y="196" text-anchor="end">B</text>
          <text x="352" y="104" text-anchor="start">C</text>
        </g>
      </svg>
    </div>

    <div class="sizechart__table-wrap">
      <table class="sizechart__table">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.label_measure }}</th>
            {%- for size in sizes -%}
              <th scope="col">{{ size | strip }}</th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- assign values = block.settings.values | default: '' | split: ',' -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">
                <span class="sizechart__letter">{{ block.settings.letter }}</span>
                {{ block.settings.label }}
              </th>
              {%- for size in sizes -%}
                {%- assign v = values[forloop.index0] | strip -%}
                <td>{% if v != blank %}{{ v }}{% if section.settings.unit != blank %} {{ section.settings.unit }}{% endif %}{% else %}—{% endif %}</td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>

  {%- if section.settings.note != blank -%}
    <p class="sizechart__note">{{ section.settings.note }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Size chart",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Size chart" },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro",
      "default": "All measurements are taken from the garment laid flat, not from the body."
    },
    {
      "type": "text",
      "id": "sizes",
      "label": "Sizes",
      "info": "Comma separated. These become the table columns.",
      "default": "S, M, L, XL"
    },
    { "type": "text", "id": "unit", "label": "Unit", "default": "cm" },
    { "type": "text", "id": "label_measure", "label": "First column heading", "default": "Measurement" },
    {
      "type": "text",
      "id": "figure_alt",
      "label": "Drawing description",
      "info": "Read aloud by screen readers.",
      "default": "Garment laid flat with measuring points A to D"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "Measured with a tolerance of ±2 cm. If in doubt, take the larger size."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Measurement",
      "settings": [
        { "type": "text", "id": "letter", "label": "Letter", "default": "A" },
        { "type": "text", "id": "label", "label": "Name", "default": "Shoulder width" },
        {
          "type": "text",
          "id": "values",
          "label": "Values",
          "info": "Comma separated, in the order of the sizes above. Numbers only — the unit is added on its own.",
          "default": "53, 55, 57, 59"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Size chart",
      "blocks": [
        { "type": "row", "settings": { "letter": "A", "label": "Shoulder width", "values": "53, 55, 57, 59" } },
        { "type": "row", "settings": { "letter": "B", "label": "Length from armpit", "values": "39, 40, 41, 43" } },
        { "type": "row", "settings": { "letter": "C", "label": "Sleeve length from shoulder", "values": "67, 68, 69, 70" } },
        { "type": "row", "settings": { "letter": "D", "label": "Hem width", "values": "55, 57, 60, 63" } }
      ]
    }
  ]
}
{% endschema %}
