{%- comment -%}
  Media — a grid of images, each one linking straight out to its own address.

  The images live in this section's own blocks. The Blog section keeps its
  own, separate blocks, so filling one in never touches the other.
{%- endcomment -%}

<div class="media-page">
  {%- if section.settings.title != blank and section.settings.show_title -%}
    <h1 class="blog-page__title">{{ section.settings.title }}</h1>
  {%- endif -%}

  {%- if page.content != blank -%}
    <div class="blog-page__intro rte">{{ page.content }}</div>
  {%- endif -%}

  {%- render 'gallery-media',
      blocks: section.blocks,
      columns: section.settings.columns,
      count: section.settings.placeholder_count -%}
</div>

{% schema %}
{
  "name": "Media",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Media" },
    { "type": "checkbox", "id": "show_title", "label": "Show title", "default": true },
    {
      "type": "paragraph",
      "content": "Add one \"Media image\" block per picture. Each block carries its own image and its own link — tapping the picture opens that link."
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Images per row",
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "info": "Every tile is cropped to the same shape so the grid stays even.",
      "options": [
        { "value": "portrait", "label": "4:5 portrait" },
        { "value": "square", "label": "Square" },
        { "value": "classic", "label": "4:3" },
        { "value": "wide", "label": "16:9" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "placeholder_count",
      "min": 3,
      "max": 20,
      "step": 1,
      "label": "Placeholder images",
      "info": "Only shown until you add your first Media image block.",
      "default": 9
    }
  ],
  "blocks": [
    {
      "type": "media_image",
      "name": "Media image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link", "info": "Where tapping this image leads." },
        { "type": "checkbox", "id": "new_tab", "label": "Open in a new tab", "default": true },
        { "type": "text", "id": "caption", "label": "Caption", "info": "Optional. Shown under the image." }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Media",
      "blocks": [
        { "type": "media_image" }, { "type": "media_image" }, { "type": "media_image" },
        { "type": "media_image" }, { "type": "media_image" }, { "type": "media_image" },
        { "type": "media_image" }, { "type": "media_image" }, { "type": "media_image" }
      ]
    }
  ]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} .gallery-grid {
    --tile-ratio: {% case section.settings.image_ratio %}
      {%- when 'square' -%}1 / 1
      {%- when 'classic' -%}4 / 3
      {%- when 'wide' -%}16 / 9
      {%- else -%}4 / 5
    {% endcase %};
  }
</style>
