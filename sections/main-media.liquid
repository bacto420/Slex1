{%- comment -%}
  Media — 6 tappable tiles. Each tile links straight out to its own URL.
{%- endcomment -%}


<div class="page-width section">
  {%- if section.settings.title != blank -%}
    <h1 class="section__title">{{ section.settings.title }}</h1>
  {%- endif -%}

  {%- if page.content != blank -%}
    <div class="rte" style="max-width: 640px; margin-bottom: var(--space-lg);">{{ page.content }}</div>
  {%- endif -%}

  {%- render 'gallery-media', blocks: section.blocks -%}
</div>

{% schema %}
{
  "name": "Media",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Media" }
  ],
  "blocks": [
    {
      "type": "media_tile",
      "name": "Media tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link", "info": "Where tapping this tile leads." },
        { "type": "checkbox", "id": "new_tab", "label": "Open in a new tab", "default": true },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Media",
      "blocks": [
        { "type": "media_tile" }, { "type": "media_tile" }, { "type": "media_tile" },
        { "type": "media_tile" }, { "type": "media_tile" }, { "type": "media_tile" }
      ]
    }
  ]
}
{% endschema %}
