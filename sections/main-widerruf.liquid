{%- liquid
  # Same rule as the dialog in the footer: an empty field falls back to the
  # language files, so the page changes language with the shop, and anything
  # typed in the editor wins over that.
  if routes.root_url == '/'
    assign privacy_url = '/pages/datenschutz'
  else
    assign privacy_url = routes.root_url | append: '/pages/datenschutz'
  endif

  assign t_heading = 'widerruf.button' | t
  assign t_intro = 'widerruf.intro_page' | t
  assign t_step1 = 'widerruf.step1' | t
  assign t_name = 'widerruf.name' | t
  assign t_order = 'widerruf.order' | t
  assign t_email = 'widerruf.email' | t
  assign t_items = 'widerruf.items' | t
  assign t_received = 'widerruf.received' | t
  assign t_next = 'widerruf.next' | t
  assign t_step2 = 'widerruf.step2' | t
  assign t_confirm_note = 'widerruf.confirm_note' | t
  assign t_confirm = 'widerruf.confirm' | t
  assign t_back = 'widerruf.back' | t
  assign t_nojs = 'widerruf.nojs' | t
  assign t_success_heading = 'widerruf.success_heading' | t
  assign t_success_text = 'widerruf.success_text' | t
  assign t_privacy = 'widerruf.privacy_note' | t: url: privacy_url
  assign t_alt = 'widerruf.alt_note' | t
  assign t_timezone = 'widerruf.timezone' | t
-%}

{%- comment -%}
  Withdrawal form — § 13a FAGG (AT, in force 01.10.2026) / § 356a BGB (DE,
  in force since 19.06.2026).

  What the law asks for and where it is handled:
    • button labelled "Vertrag widerrufen"        → footer.liquid
    • reachable without login, guests included    → this is a plain page
    • form with name, contract ID, contact means  → fields below
    • a SECOND button "Widerruf bestätigen"       → the confirm step below
    • acknowledgement by email, with date + time  → see the note in the
      schema; Shopify's contact form mails the shop, so the customer-facing
      acknowledgement needs one of the routes described there.
{%- endcomment -%}

<div class="widerruf">
  <h1 class="widerruf__title">{{ section.settings.heading | default: t_heading }}</h1>

  {%- form 'contact', class: 'widerruf__form', id: 'WiderrufForm' -%}
    {%- if form.posted_successfully? -%}
      {%- comment -%}
        Shopify redirects back with this flag once the form is accepted.
        The on-screen stamp is a courtesy — the acknowledgement that the
        statute requires is the email, see the schema notes.
      {%- endcomment -%}
      <div class="widerruf__done" role="status">
        <h2>{{ section.settings.success_heading | default: t_success_heading }}</h2>
        <div class="rte">{{ section.settings.success_text | default: t_success_text }}</div>
        <p class="widerruf__stamp">
          {{ 'now' | date: '%d.%m.%Y, %H:%M' }} {{ section.settings.timezone_label | default: t_timezone }}
        </p>
        <p><a class="btn btn--ghost btn--inline" href="{{ routes.root_url }}">{{ 'general.nav.home' | t }}</a></p>
      </div>

    {%- else -%}
      {%- if form.errors -%}
        <div class="widerruf__errors" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="widerruf__intro rte">{{ section.settings.intro | default: t_intro }}</div>

      {%- comment -%} Step 1 — the three fields the statute requires. {%- endcomment -%}
      <div class="widerruf__step" data-step="1">
        <p class="widerruf__legend">{{ section.settings.step1_label | default: t_step1 }}</p>

        <label class="field-label" for="WiderrufName">
          {{ section.settings.label_name | default: t_name }} *
        </label>
        <input type="text" id="WiderrufName" name="contact[name]" required
               autocomplete="name" data-required>

        <label class="field-label" for="WiderrufOrder">
          {{ section.settings.label_order | default: t_order }} *
        </label>
        <input type="text" id="WiderrufOrder" name="contact[Bestellnummer]" required
               placeholder="#1001" data-required>

        <label class="field-label" for="WiderrufEmail">
          {{ section.settings.label_email | default: t_email }} *
        </label>
        <input type="email" id="WiderrufEmail" name="contact[email]" required
               autocomplete="email" data-required>

        <label class="field-label" for="WiderrufItems">
          {{ section.settings.label_items | default: t_items }}
        </label>
        <textarea id="WiderrufItems" name="contact[Artikel]" rows="3"></textarea>

        <label class="field-label" for="WiderrufReceived">
          {{ section.settings.label_received | default: t_received }}
        </label>
        <input type="date" id="WiderrufReceived" name="contact[Erhalten am]">

        <input type="hidden" name="contact[Art der Meldung]" value="Widerruf über die Rücktrittsfunktion">
        <input type="hidden" name="contact[Abgesendet am]" id="WiderrufStamp" value="">
        <input type="hidden" name="contact[body]" id="WiderrufBody" value="Widerruf über die Rücktrittsfunktion der Website.">

        <button type="button" class="btn btn--inline" data-widerruf-next>
          {{ section.settings.next_label | default: t_next }}
        </button>
      </div>

      {%- comment -%}
        Step 2 — the confirmation the statute demands. The button carries
        nothing but the required wording.
      {%- endcomment -%}
      <div class="widerruf__step widerruf__step--confirm" data-step="2" hidden>
        <p class="widerruf__legend">{{ section.settings.step2_label | default: t_step2 }}</p>

        <dl class="widerruf__review" data-widerruf-review></dl>

        <div class="widerruf__note rte">{{ section.settings.confirm_note | default: t_confirm_note }}</div>

        <div class="widerruf__actions">
          <button type="submit" class="btn btn--confirm">
            {{ section.settings.confirm_label | default: t_confirm }}
          </button>
          <button type="button" class="btn btn--ghost btn--inline" data-widerruf-back>
            {{ section.settings.back_label | default: t_back }}
          </button>
        </div>
      </div>


      {%- comment -%}
        Art. 13 DSGVO — the person has to be told what happens with the data
        at the moment it is collected, not somewhere else on the site.
      {%- endcomment -%}
      <div class="widerruf__privacy rte">{{ section.settings.privacy_note | default: t_privacy }}</div>

      <noscript>
        <div class="widerruf__note">
          <p>{{ section.settings.noscript_note | default: t_nojs }}</p>
          <button type="submit" class="btn btn--confirm">
            {{ section.settings.confirm_label | default: t_confirm }}
          </button>
        </div>
      </noscript>

      <div class="widerruf__alt rte">{{ section.settings.alt_note | default: t_alt }}</div>
    {%- endif -%}
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Widerruf form",
  "settings": [
    {
      "type": "paragraph",
      "content": "Every field here may stay empty: the wording then comes from locales/de.json and locales/en.default.json and switches with the shop's language. Anything typed here overrides that, for all languages at once."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "privacy_note",
      "label": "Privacy note at the form",
      "info": "Art. 13 DSGVO — shown with the form itself. Point the link at your privacy page."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "text",
      "id": "step1_label",
      "label": "Step 1 heading"
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Field: name"
    },
    {
      "type": "text",
      "id": "label_order",
      "label": "Field: order number"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Field: email"
    },
    {
      "type": "text",
      "id": "label_items",
      "label": "Field: items"
    },
    {
      "type": "text",
      "id": "label_received",
      "label": "Field: received on"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Button: go to confirmation"
    },
    {
      "type": "text",
      "id": "step2_label",
      "label": "Step 2 heading"
    },
    {
      "type": "richtext",
      "id": "confirm_note",
      "label": "Note above the confirm button"
    },
    {
      "type": "text",
      "id": "confirm_label",
      "label": "Confirmation button",
      "info": "Statutory wording. Only change to an equally unambiguous phrase such as \"Rücktritt bestätigen\"."
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Button: back"
    },
    {
      "type": "text",
      "id": "noscript_note",
      "label": "Note shown without JavaScript"
    },
    {
      "type": "header",
      "content": "After sending"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Success heading"
    },
    {
      "type": "richtext",
      "id": "success_text",
      "label": "Success text"
    },
    {
      "type": "text",
      "id": "timezone_label",
      "label": "Time zone label",
      "default": "(Wien)"
    },
    {
      "type": "richtext",
      "id": "alt_note",
      "label": "Alternative ways to withdraw"
    }
  ],
  "presets": [
    {
      "name": "Widerruf form"
    }
  ]
}
{% endschema %}
