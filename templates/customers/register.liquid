<div class="article">
  <h1>{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer' -%}
    <label class="field-label" for="FirstName">{{ 'customer.field.first_name' | t }}</label>
    <input type="text" name="customer[first_name]" id="FirstName">
    <label class="field-label" for="LastName">{{ 'customer.field.last_name' | t }}</label>
    <input type="text" name="customer[last_name]" id="LastName">
    <label class="field-label" for="Email">{{ 'customer.field.email' | t }}</label>
    <input type="email" name="customer[email]" id="Email">
    <label class="field-label" for="Password">{{ 'customer.field.password' | t }}</label>
    <input type="password" name="customer[password]" id="Password">
    <button type="submit" class="btn">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</div>
