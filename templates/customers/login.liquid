<div class="article">
  <h1>{{ 'customer.login.title' | t }}</h1>
  {%- form 'customer_login' -%}
    <label class="field-label" for="CustomerEmail">{{ 'customer.field.email' | t }}</label>
    <input type="email" name="customer[email]" id="CustomerEmail">
    <label class="field-label" for="CustomerPassword">{{ 'customer.field.password' | t }}</label>
    <input type="password" name="customer[password]" id="CustomerPassword">
    <button type="submit" class="btn">{{ 'customer.login.submit' | t }}</button>
  {%- endform -%}
</div>
