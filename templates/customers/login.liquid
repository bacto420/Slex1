<div class="article">
  <h1>Login</h1>
  {%- form 'customer_login' -%}
    <label class="field-label" for="CustomerEmail">Email</label>
    <input type="email" name="customer[email]" id="CustomerEmail">
    <label class="field-label" for="CustomerPassword">Password</label>
    <input type="password" name="customer[password]" id="CustomerPassword">
    <button type="submit" class="btn">Sign in</button>
  {%- endform -%}
</div>
