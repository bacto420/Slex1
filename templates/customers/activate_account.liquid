<div class="article">
  <h1>{{ 'customer.activate.title' | t }}</h1>
  {%- form 'activate_customer_password' -%}
    <label class="field-label" for="apw">{{ 'customer.field.password' | t }}</label>
    <input type="password" name="customer[password]" id="apw">
    <button type="submit" class="btn">{{ 'customer.activate.submit' | t }}</button>
  {%- endform -%}
</div>
