<div class="article">
  <h1>{{ 'customer.account.title' | t }}</h1>
  <p class="card__meta">{{ customer.email }}</p>
  <ul>
    {%- for order in customer.orders -%}
      <li><a href="{{ order.customer_url }}">{{ order.name }} — {{ order.created_at | date: '%d.%m.%Y' }}</a></li>
    {%- endfor -%}
  </ul>
  <p><a class="btn btn--ghost btn--inline" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.title' | t }}</a></p>
</div>
