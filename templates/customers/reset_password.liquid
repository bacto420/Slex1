<div class="article">
  <h1>{{ 'customer.reset.title' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    <label class="field-label" for="pw">{{ 'customer.field.new_password' | t }}</label>
    <input type="password" name="customer[password]" id="pw">
    <button type="submit" class="btn">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</div>
